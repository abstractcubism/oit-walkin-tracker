# Copy to .env (or put these in the systemd unit) and fill in.

# Public address people use to reach the app. Used for links in Slack posts.
BASE_URL=https://walkins.oit.rutgers.edu
PORT=3000
DB_PATH=./data/walkins.db

# Always admins (comma-separated). Everyone else is managed on the Admin page.
ADMIN_EMAILS=

# ---- Sign-in: fill in either or both. Each turns on when its client ID is set. ----

# Google (OAuth client ID from Google Cloud Console, type "Web application").
# Authorized JavaScript origin: your BASE_URL. Students share this domain, so Google
# users must also be on the consultant list.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=scarletmail.rutgers.edu

# Microsoft Entra ID (app registration in the Rutgers tenant).
# Redirect URI (Web): ${BASE_URL}/auth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_ALLOWED_DOMAINS=oit.rutgers.edu
# true: any @oit account may sign in as a consultant. false: they must be on the list too.
MS_AUTO_ALLOW=true

# ---- Behavior ----
SESSION_HOURS=12
# Erase NetID / name / email / description after this many days (0 = never).
RETENTION_DAYS=90
# Require a ServiceNow ticket number before marking a walk-in resolved.
REQUIRE_TICKET=true

# ServiceNow address for ticket links. Rutgers' IT Help portal (ithelp.rutgers.edu) runs on
# ServiceNow; if staff use a different address for the back end, put it here.
SERVICENOW_URL=https://ithelp.rutgers.edu

# ---- Slack (optional, do last) ----
# Incoming webhook URL for the walk-ins channel. Leave empty to turn posting off.
SLACK_WEBHOOK_URL=

# ---- Google Sheet copy (optional) ----
# Copies every walk-in to a Google Sheet tab. The app keeps working from its own database, so
# the Sheet being slow or down never affects the iPads or queue. Test with: npm run sheets:check
# off | apps-script | service-account
SHEETS_MODE=off
SHEETS_TAB=Walk-ins
# false leaves NetID, name, email, description and notes out of the Sheet.
SHEETS_INCLUDE_PERSONAL=true
# How often queued changes are sent, in seconds.
SHEETS_PUSH_SECONDS=5

# apps-script: deploy apps-script/Code.gs from the Sheet as a web app (steps are in that file).
SHEETS_APPS_SCRIPT_URL=
SHEETS_APPS_SCRIPT_SECRET=

# service-account: share the Sheet with the service account's email as an Editor.
SHEETS_SPREADSHEET_ID=
SHEETS_SA_KEY_FILE=./secrets/sheets-service-account.json

# Local testing only. Never true in production.
DEV_LOGIN=false
COOKIE_SECURE=true
